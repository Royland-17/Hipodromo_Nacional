@model Hipodromo_Nacional.ViewModels.PropietarioViewModel
@{
    ViewData["Title"] = "Nuevo Propietario";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
<div class="card-hipodromo">
    <div class="card-header-custom">
        <h5><i class="fas fa-user-plus me-2"></i>Nuevo Propietario</h5>
        <a asp-action="Index" class="btn-outline-gold text-decoration-none">
            <i class="fas fa-arrow-left me-1"></i> Volver
        </a>
    </div>
    <div class="card-body-custom">
        <form asp-action="Crear" method="post" id="createPropietarioForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger-custom mb-3"></div>

            <h5 class="section-title-custom">Datos de acceso</h5>
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label asp-for="Usuario" class="form-label-custom"></label>
                    <input asp-for="Usuario" class="form-control-custom" />
                    <span asp-validation-for="Usuario" class="text-danger-custom"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Contrasena" class="form-label-custom"></label>
                    <input asp-for="Contrasena" class="form-control-custom" type="password" />
                    <span asp-validation-for="Contrasena" class="text-danger-custom"></span>
                </div>
            </div>

            <h5 class="section-title-custom">Datos personales</h5>
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <label asp-for="Identificacion" class="form-label-custom"></label>
                    <input asp-for="Identificacion" class="form-control-custom" />
                    <span asp-validation-for="Identificacion" class="text-danger-custom"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Nombre" class="form-label-custom"></label>
                    <input asp-for="Nombre" class="form-control-custom" />
                    <span asp-validation-for="Nombre" class="text-danger-custom"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Apellido1" class="form-label-custom"></label>
                    <input asp-for="Apellido1" class="form-control-custom" />
                    <span asp-validation-for="Apellido1" class="text-danger-custom"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Apellido2" class="form-label-custom"></label>
                    <input asp-for="Apellido2" class="form-control-custom" />
                    <span asp-validation-for="Apellido2" class="text-danger-custom"></span>
                </div>
            </div>

            <h5 class="section-title-custom">Dirección</h5>
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label asp-for="IdPais" class="form-label-custom"></label>
                    <select asp-for="IdPais" asp-items="Model.Paises" class="form-select-custom" id="selPais">
                    </select>
                    <span asp-validation-for="IdPais" class="text-danger-custom"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IdProvincia" class="form-label-custom"></label>
                    <select asp-for="IdProvincia" class="form-select-custom" id="selProvincia">
                        <option value="">-- Seleccione país primero --</option>
                    </select>
                    <span asp-validation-for="IdProvincia" class="text-danger-custom"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IdCanton" class="form-label-custom"></label>
                    <select asp-for="IdCanton" class="form-select-custom" id="selCanton">
                        <option value="">-- Seleccione provincia primero --</option>
                    </select>
                    <span asp-validation-for="IdCanton" class="text-danger-custom"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IdDistrito" class="form-label-custom"></label>
                    <select asp-for="IdDistrito" class="form-select-custom" id="selDistrito">
                        <option value="">-- Seleccione cantón primero --</option>
                    </select>
                    <span asp-validation-for="IdDistrito" class="text-danger-custom"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IdBarrio" class="form-label-custom"></label>
                    <select asp-for="IdBarrio" class="form-select-custom" id="selBarrio">
                        <option value="">-- Seleccione distrito primero --</option>
                    </select>
                    <span asp-validation-for="IdBarrio" class="text-danger-custom"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="DireccionExacta" class="form-label-custom"></label>
                <textarea asp-for="DireccionExacta" class="form-control-custom" rows="3"></textarea>
                <span asp-validation-for="DireccionExacta" class="text-danger-custom"></span>
            </div>

            <div class="d-flex justify-content-end gap-3 pt-2">
                <a asp-action="Index" class="btn-outline-gold text-decoration-none">Cancelar</a>
                <button type="submit" class="btn-gold" id="btnGuardarPropietario">Guardar</button>
            </div>
        </form>
    </div>
</div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const urls = {
                provincias: '@Url.Action("ObtenerProvincias", "Propietarios")',
                cantones: '@Url.Action("ObtenerCantones", "Propietarios")',
                distritos: '@Url.Action("ObtenerDistritos", "Propietarios")',
                barrios: '@Url.Action("ObtenerBarrios", "Propietarios")'
            };

            const selPais = document.getElementById('selPais');
            const selProvincia = document.getElementById('selProvincia');
            const selCanton = document.getElementById('selCanton');
            const selDistrito = document.getElementById('selDistrito');
            const selBarrio = document.getElementById('selBarrio');
            const form = document.getElementById('createPropietarioForm');
            const btnGuardar = document.getElementById('btnGuardarPropietario');

            function resetSelect(select, placeholder) {
                select.innerHTML = '';
                select.add(new Option(placeholder, ''));
            }

            async function fetchItems(url, key, value) {
                if (!value) return [];

                async function run(timeoutMs) {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), timeoutMs);

                    try {
                        const response = await fetch(`${url}?${key}=${encodeURIComponent(value)}`, {
                            method: 'GET',
                            headers: { 'Accept': 'application/json' },
                            cache: 'no-store',
                            signal: controller.signal
                        });

                        if (!response.ok) return null;
                        return await response.json();
                    } catch {
                        return null;
                    } finally {
                        clearTimeout(timeoutId);
                    }
                }

                const firstAttempt = await run(12000);
                if (Array.isArray(firstAttempt)) return firstAttempt;

                const secondAttempt = await run(25000);
                if (Array.isArray(secondAttempt)) return secondAttempt;

                return [];
            }

            function fillSelect(select, placeholder, items) {
                resetSelect(select, placeholder);
                for (const item of items) {
                    select.add(new Option(item.text, item.value));
                }
            }

            function tryAutoSelectSingle(select) {
                const validOptions = Array.from(select.options).filter(option => option.value);
                if (validOptions.length === 1) {
                    select.value = validOptions[0].value;
                    return true;
                }

                return false;
            }

            async function onPaisChanged(autoAdvance = false) {
                const items = await fetchItems(urls.provincias, 'idPais', selPais.value);
                fillSelect(
                    selProvincia,
                    items.length > 0 ? '-- Seleccione --' : '-- No hay provincias disponibles --',
                    items
                );
                resetSelect(selCanton, '-- Seleccione provincia primero --');
                resetSelect(selDistrito, '-- Seleccione cantón primero --');
                resetSelect(selBarrio, '-- Seleccione distrito primero --');

                if (autoAdvance && tryAutoSelectSingle(selProvincia)) {
                    await onProvinciaChanged(true);
                }
            }

            async function onProvinciaChanged(autoAdvance = false) {
                const items = await fetchItems(urls.cantones, 'idProvincia', selProvincia.value);
                fillSelect(
                    selCanton,
                    items.length > 0 ? '-- Seleccione --' : '-- No hay cantones disponibles --',
                    items
                );
                resetSelect(selDistrito, '-- Seleccione cantón primero --');
                resetSelect(selBarrio, '-- Seleccione distrito primero --');

                if (autoAdvance && tryAutoSelectSingle(selCanton)) {
                    await onCantonChanged(true);
                }
            }

            async function onCantonChanged(autoAdvance = false) {
                const items = await fetchItems(urls.distritos, 'idCanton', selCanton.value);
                fillSelect(
                    selDistrito,
                    items.length > 0 ? '-- Seleccione --' : '-- No hay distritos disponibles --',
                    items
                );
                resetSelect(selBarrio, '-- Seleccione distrito primero --');

                if (autoAdvance && tryAutoSelectSingle(selDistrito)) {
                    await onDistritoChanged(true);
                }
            }

            async function onDistritoChanged(autoAdvance = false) {
                const items = await fetchItems(urls.barrios, 'idDistrito', selDistrito.value);
                fillSelect(
                    selBarrio,
                    items.length > 0 ? '-- Seleccione --' : '-- No hay barrios disponibles --',
                    items
                );

                if (autoAdvance) {
                    tryAutoSelectSingle(selBarrio);
                }
            }

            selPais.addEventListener('change', onPaisChanged);
            selProvincia.addEventListener('change', onProvinciaChanged);
            selCanton.addEventListener('change', onCantonChanged);
            selDistrito.addEventListener('change', onDistritoChanged);

            async function initializeForm() {
                const validCountryOptions = Array.from(selPais.options).filter(option => option.value);
                if (!selPais.value && validCountryOptions.length === 1) {
                    selPais.value = validCountryOptions[0].value;
                }

                if (selPais.value) {
                    await onPaisChanged(true);
                }
            }

            form?.addEventListener('submit', () => {
                if (!btnGuardar) return;

                btnGuardar.disabled = true;
                btnGuardar.textContent = 'Guardando...';
            });

            void initializeForm();
        })();
    </script>
}
