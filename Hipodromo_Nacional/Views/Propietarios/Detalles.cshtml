@model Hipodromo_Nacional.Models.Propietario
@{
    ViewData["Title"] = "Detalle Propietario";
    var u = Model.IdUsuarioNavigation;
    var b = Model.IdBarrioNavigation;
    var dis = b?.IdDistritoNavigation;
    var can = dis?.IdCantonNavigation;
    var pro = can?.IdProvinciaNavigation;
    var pai = pro?.IdPaisNavigation;
}

<div class="card-hipodromo">
    <div class="card-header-custom">
        <h5><i class="fas fa-user me-2"></i>Detalle del Propietario</h5>
    </div>
    <div class="card-body-custom">
        <dl class="row">
            <dt class="col-sm-3">Identificación</dt>
            <dd class="col-sm-9">@u?.Identificacion</dd>

            <dt class="col-sm-3">Nombre completo</dt>
            <dd class="col-sm-9">@u?.Nombre @u?.Apellido1 @u?.Apellido2</dd>

            <dt class="col-sm-3">Usuario</dt>
            <dd class="col-sm-9">@u?.Usuario1</dd>

            <dt class="col-sm-3">Fecha de registro</dt>
            <dd class="col-sm-9">@u?.FechaRegistro?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Activo</dt>
            <dd class="col-sm-9">
                @if (u?.Activo == true)
                {
                    <span class="badge-salud badge-ok">Sí</span>
                }
                else
                {
                    <span class="badge-salud badge-info">No</span>
                }
            </dd>

            <dt class="col-sm-3">País</dt>
            <dd class="col-sm-9">@pai?.Nombre</dd>

            <dt class="col-sm-3">Provincia</dt>
            <dd class="col-sm-9">@pro?.Nombre</dd>

            <dt class="col-sm-3">Cantón</dt>
            <dd class="col-sm-9">@can?.Nombre</dd>

            <dt class="col-sm-3">Distrito</dt>
            <dd class="col-sm-9">@dis?.Nombre</dd>

            <dt class="col-sm-3">Barrio</dt>
            <dd class="col-sm-9">@b?.Nombre</dd>

            <dt class="col-sm-3">Dirección exacta</dt>
            <dd class="col-sm-9">@(Model.DireccionExacta ?? "-")</dd>
        </dl>

        <div class="d-flex gap-2">
            <a asp-action="Editar" asp-route-id="@Model.IdPropietario" class="btn-gold">Editar</a>
            <a asp-action="Index" class="btn-outline-gold">Volver</a>
        </div>
    </div>
</div>
