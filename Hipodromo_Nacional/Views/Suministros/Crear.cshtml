@model SuministroViewModel
@{
    ViewData["Title"] = "Nuevo Suministro";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-box-open me-2"></i>Nuevo Suministro</h5>
                <a asp-action="Index" class="btn-outline-gold text-decoration-none">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
            <div class="card-body-custom">
        <form asp-action="Crear" method="post">
            <input type="hidden" asp-for="FechaIngreso" />
            <div asp-validation-summary="ModelOnly" class="text-danger-custom mb-3"></div>
            <div class="alert-custom alert-info-custom" role="alert">
                La fecha de ingreso se registra automaticamente con la fecha actual del sistema.
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <label asp-for="Codigo" class="form-label-custom"></label>
                    <input asp-for="Codigo" class="form-control-custom" />
                    <span asp-validation-for="Codigo" class="text-danger-custom"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IdTipoSuministro" class="form-label-custom"></label>
                    <select asp-for="IdTipoSuministro" asp-items="Model.TiposSuministro" class="form-select-custom">
                        <option value="">Seleccione...</option>
                    </select>
                    <span asp-validation-for="IdTipoSuministro" class="text-danger-custom"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IdProveedor" class="form-label-custom"></label>
                    <select asp-for="IdProveedor" asp-items="Model.Proveedores" class="form-select-custom">
                        <option value="">Seleccione...</option>
                    </select>
                    <span asp-validation-for="IdProveedor" class="text-danger-custom"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CantidadDisponible" class="form-label-custom"></label>
                    <input asp-for="CantidadDisponible" class="form-control-custom" />
                    <span asp-validation-for="CantidadDisponible" class="text-danger-custom"></span>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end gap-3 pt-2">
                <a asp-action="Index" class="btn-outline-gold text-decoration-none">Cancelar</a>
                <button type="submit" class="btn-gold">
                    <i class="fas fa-save me-2"></i> Guardar suministro
                </button>
            </div>
        </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
