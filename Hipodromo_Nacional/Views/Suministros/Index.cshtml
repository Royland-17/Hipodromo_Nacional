@model IEnumerable<SuministroListaViewModel>
@{
    ViewData["Title"] = "Suministros";
}

<div class="card-hipodromo">
    <div class="card-header-custom">
        <h5><i class="fas fa-boxes-stacked me-2"></i>Suministros</h5>
        <a asp-action="Crear" class="btn-gold text-decoration-none">
            <i class="fas fa-plus me-1"></i> Nuevo suministro
        </a>
    </div>
    <div class="card-body-custom">
        <div style="overflow-x:auto">
            <table class="table-hipodromo">
                <thead>
                    <tr>
                        <th>Codigo</th>
                        <th>Tipo</th>
                        <th>Proveedor</th>
                        <th>Estado</th>
                        <th class="text-end">Cantidad disponible</th>
                        <th>Fecha de ingreso</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="empty-state-custom">No hay suministros registrados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Codigo</td>
                            <td>@item.Tipo</td>
                            <td>@item.Proveedor</td>
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge-salud badge-ok">Activo</span>
                                }
                                else
                                {
                                    <span class="badge-salud badge-info">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">@item.CantidadDisponible</td>
                            <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="table-actions">
                                <a asp-action="Editar" asp-route-id="@item.IdSuministro" class="btn-outline-gold text-decoration-none">Editar</a>
                                @if (item.Activo)
                                {
                                    <form asp-action="Desactivar" asp-route-id="@item.IdSuministro" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-outline-danger-custom" onclick="return confirm('Desea desactivar este suministro?');">Desactivar</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activar" asp-route-id="@item.IdSuministro" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-outline-gold" onclick="return confirm('Desea activar nuevamente este suministro?');">Activar</button>
                                    </form>
                                }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
