@model List<Hipodromo_Nacional.ViewModels.ResultadoPropietarioViewModel>
@{
    ViewData["Title"] = "Consultar Resultados";
}

<div class="card-hipodromo">
    <div class="card-header-custom">
        <h5><i class="fas fa-list-check me-2"></i>Resultados de Mis Caballos</h5>
    </div>
    <div class="card-body-custom">
        @if (!Model.Any())
        {
            <div class="text-center py-5" style="color:var(--text-muted)">
                <i class="fas fa-flag-checkered" style="font-size:3rem;opacity:.3"></i>
                <p class="mt-3 mb-0">No hay resultados disponibles para tus caballos.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Evento</th>
                            <th>Fecha</th>
                            <th>Caballo</th>
                            <th>Posición</th>
                            <th>Tiempo (s)</th>
                            <th>Premio</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:600">@r.Evento</div>
                                    <div style="font-size:.8rem;color:var(--text-muted)">@r.CodigoEvento</div>
                                </td>
                                <td>@(r.FechaEvento?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@r.Caballo</td>
                                <td>@(r.PosicionFinal?.ToString() ?? "-")</td>
                                <td>@(r.TiempoSegundos?.ToString("0.##") ?? "-")</td>
                                <td>@(r.PremioObtenido?.ToString("C") ?? "-")</td>
                                <td>
                                    @if (r.Descalificado)
                                    {
                                        <span class="badge bg-danger">Descalificado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Válido</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
