@model Hipodromo_Nacional.ViewModels.CrearFacturaViewModel
@{
    ViewData["Title"] = "Nueva Factura";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-file-invoice-dollar me-2"></i>Nueva Factura</h5>
                <a href="@Url.Action("Index")" class="btn-outline-gold">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
            <div class="card-body-custom">
                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert-custom" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#f87171;margin-bottom:16px">
                            <i class="fas fa-circle-exclamation me-2"></i>
                            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@e.ErrorMessage</div>
                            }
                        </div>
                    }

                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label-custom">Propietario *</label>
                            <select asp-for="IdPropietario" asp-items="Model.Propietarios" class="form-select-custom" id="propietarioSelect">
                                <option value="">Seleccionar...</option>
                            </select>
                            <span asp-validation-for="IdPropietario" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Fecha *</label>
                            <input asp-for="FechaFactura" type="date" class="form-control-custom" />
                            <span asp-validation-for="FechaFactura" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Estado de Pago *</label>
                            <select asp-for="IdEstadoPago" asp-items="Model.EstadosPago" class="form-select-custom">
                                <option value="">Seleccionar...</option>
                            </select>
                            <span asp-validation-for="IdEstadoPago" class="text-danger-custom"></span>
                        </div>

                        <!-- Inscripciones disponibles -->
                        <div class="col-12">
                            <label class="form-label-custom">Inscripciones a Facturar *</label>
                            <div id="inscripcionesContainer">
                                @if (!Model.InscripcionesDisponibles.Any())
                                {
                                    <div id="sinInscripciones" style="color:var(--text-muted);font-size:.85rem;padding:12px;border:1px solid var(--border);border-radius:8px">
                                        Selecciona un propietario para ver sus inscripciones disponibles.
                                    </div>
                                }
                                else
                                {
                                    <div id="sinInscripciones" style="color:var(--text-muted);font-size:.85rem;padding:12px;border:1px solid var(--border);border-radius:8px;display:none">
                                        No hay inscripciones disponibles para este propietario.
                                    </div>
                                    <div id="tablaInscripciones" style="border:1px solid var(--border);border-radius:8px;overflow:hidden;max-height:300px;overflow-y:auto">
                                        <table class="table-hipodromo" style="margin:0">
                                            <thead>
                                                <tr>
                                                    <th style="width:40px"></th>
                                                    <th>Evento</th>
                                                    <th>Caballo</th>
                                                    <th>Fecha Inscripción</th>
                                                    <th>Precio</th>
                                                </tr>
                                            </thead>
                                            <tbody id="inscripcionesBody">
                                                @foreach (var ins in Model.InscripcionesDisponibles)
                                                {
                                                    <tr class="fila-inscripcion" data-propietario-id="@ins.IdPropietario" style="cursor:pointer;display:none" onclick="this.querySelector('input').click()">
                                                        <td>
                                                            <input type="checkbox" name="InscripcionesSeleccionadas" value="@ins.IdInscripcion"
                                                                data-propietario-id="@ins.IdPropietario"
                                                                   style="accent-color:var(--gold);width:16px;height:16px" />
                                                        </td>
                                                        <td style="font-size:.85rem">@ins.Evento</td>
                                                        <td style="font-weight:500">@ins.Caballo</td>
                                                        <td style="font-size:.82rem;color:var(--text-muted)">@(ins.FechaInscripcion?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                        <td style="color:var(--gold)">₡@ins.PrecioUnitario.ToString("N2")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-3 pt-2">
                            <a href="@Url.Action("Index")" class="btn-outline-gold py-2 px-4 text-decoration-none">Cancelar</a>
                            <button type="submit" class="btn-gold py-2 px-4">
                                <i class="fas fa-save me-2"></i> Crear Factura
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const propietarioSelect = document.getElementById('propietarioSelect');
            const sinInscripciones  = document.getElementById('sinInscripciones');
            const tablaInscripciones = document.getElementById('tablaInscripciones');
            const filas = Array.from(document.querySelectorAll('.fila-inscripcion'));

            if (!propietarioSelect) return;

            function filtrarInscripciones() {
                const idSeleccionado = propietarioSelect.value;

                // desmarcar checkboxes ocultos
                filas.forEach(fila => {
                    const visible = fila.dataset.propietarioId === idSeleccionado;
                    fila.style.display = visible ? '' : 'none';
                    if (!visible) fila.querySelector('input[type="checkbox"]').checked = false;
                });

                const hayFilas = filas.some(f => f.dataset.propietarioId === idSeleccionado);

                if (!idSeleccionado) {
                    if (sinInscripciones)  { sinInscripciones.style.display = ''; sinInscripciones.textContent = 'Selecciona un propietario para ver sus inscripciones disponibles.'; }
                    if (tablaInscripciones) tablaInscripciones.style.display = 'none';
                } else if (!hayFilas) {
                    if (sinInscripciones)  { sinInscripciones.style.display = ''; sinInscripciones.textContent = 'No hay inscripciones disponibles para este propietario.'; }
                    if (tablaInscripciones) tablaInscripciones.style.display = 'none';
                } else {
                    if (sinInscripciones)  sinInscripciones.style.display = 'none';
                    if (tablaInscripciones) tablaInscripciones.style.display = '';
                }
            }

            propietarioSelect.addEventListener('change', filtrarInscripciones);
            filtrarInscripciones();
        })();
    </script>
}
