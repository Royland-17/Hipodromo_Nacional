@model Hipodromo_Nacional.ViewModels.FacturaDetalleViewModel
@{
    ViewData["Title"] = "Detalle Factura";
    var badgeClass = Model.EstadoPago.ToLower().Contains("pagad") ? "badge-ok" : Model.IdEstadoPago == 1 ? "badge-warn" : "badge-danger";
}

<div class="row g-4">
    <!-- Encabezado factura -->
    <div class="col-12">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <div>
                    <h5 style="margin:0"><i class="fas fa-file-invoice-dollar me-2"></i>@Model.NumeroFactura</h5>
                    <small style="color:var(--text-muted)">Emitida el @(Model.FechaFactura?.ToString("dd/MM/yyyy") ?? "—")</small>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span class="badge-salud @badgeClass">@Model.EstadoPago</span>
                    @if (!Model.EstadoPago.ToLower().Contains("pagad"))
                    {
                        <a href="@Url.Action("RegistrarPago", new { id = Model.IdFactura })" class="btn-gold">
                            <i class="fas fa-money-bill me-1"></i> Registrar Pago
                        </a>
                    }
                    <a href="@Url.Action("Index")" class="btn-outline-gold">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </div>
            <div class="card-body-custom">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div style="color:var(--text-muted);font-size:.8rem">PROPIETARIO</div>
                        <div style="font-weight:600;font-size:1rem">@Model.Propietario</div>
                    </div>
                    <div class="col-md-6">
                        <div class="row g-2" style="font-size:.88rem">
                            <div class="col-6 d-flex justify-content-between" style="color:var(--text-muted)">
                                <span>Subtotal</span><span style="color:var(--text-primary)">₡@Model.Subtotal.ToString("N2")</span>
                            </div>
                            <div class="col-6 d-flex justify-content-between" style="color:var(--text-muted)">
                                <span>Descuento (@Model.DescuentoPct%)</span><span style="color:#4ade80">-₡@Model.MontoDescuento.ToString("N2")</span>
                            </div>
                            <div class="col-6 d-flex justify-content-between" style="color:var(--text-muted)">
                                <span>Base imponible</span><span style="color:var(--text-primary)">₡@Model.BaseImponible.ToString("N2")</span>
                            </div>
                            <div class="col-6 d-flex justify-content-between" style="color:var(--text-muted)">
                                <span>IVA (13%)</span><span style="color:var(--text-primary)">₡@Model.ImpuestoIva.ToString("N2")</span>
                            </div>
                            <div class="col-6 d-flex justify-content-between" style="color:var(--text-muted)">
                                <span>Comisión admin</span><span style="color:var(--text-primary)">₡@Model.ComisionAdmin.ToString("N2")</span>
                            </div>
                            <div class="col-6 d-flex justify-content-between" style="border-top:1px solid var(--border);padding-top:6px;font-weight:700">
                                <span style="color:var(--gold)">TOTAL</span><span style="color:var(--gold)">₡@Model.Total.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detalle inscripciones -->
    <div class="col-lg-7">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h6 style="margin:0"><i class="fas fa-list me-2"></i>Inscripciones Facturadas</h6>
            </div>
            <div class="card-body-custom p-0">
                @if (!Model.Detalles.Any())
                {
                    <p style="color:var(--text-muted);padding:20px">Sin líneas de detalle.</p>
                }
                else
                {
                    <table class="table-hipodromo">
                        <thead>
                            <tr>
                                <th>Evento</th>
                                <th>Caballo</th>
                                <th>Precio</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Detalles)
                            {
                                <tr>
                                    <td style="font-size:.85rem">@d.Evento</td>
                                    <td style="font-weight:500">@d.Caballo</td>
                                    <td>₡@d.PrecioUnitario.ToString("N2")</td>
                                    <td style="color:var(--gold)">₡@d.SubtotalLinea.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Historial de transacciones -->
    <div class="col-lg-5">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h6 style="margin:0"><i class="fas fa-receipt me-2"></i>Historial de Pagos</h6>
            </div>
            <div class="card-body-custom p-0">
                @if (!Model.Transacciones.Any())
                {
                    <div class="text-center py-4" style="color:var(--text-muted)">
                        <i class="fas fa-receipt" style="font-size:2rem;opacity:.3"></i>
                        <p class="mt-2" style="font-size:.85rem">Sin pagos registrados.</p>
                    </div>
                }
                else
                {
                    <table class="table-hipodromo">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Método</th>
                                <th>Monto</th>
                                <th>Referencia</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Transacciones)
                            {
                                <tr>
                                    <td style="white-space:nowrap;font-size:.82rem">@(t.FechaPago?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                    <td style="font-size:.82rem">@t.MetodoPago</td>
                                    <td style="color:#4ade80;font-weight:600">₡@t.Monto.ToString("N2")</td>
                                    <td style="color:var(--text-muted);font-size:.8rem">@(t.Referencia ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="padding:12px 16px;border-top:1px solid var(--border);text-align:right;font-size:.85rem">
                        Total pagado: <strong style="color:#4ade80">₡@Model.Transacciones.Sum(t => t.Monto).ToString("N2")</strong>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
