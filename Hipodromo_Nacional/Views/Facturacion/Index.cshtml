@model List<Hipodromo_Nacional.ViewModels.FacturaListViewModel>
@{
    ViewData["Title"] = "Facturación";
    var esAdministrador = User.IsInRole("Administrador");
}

<div class="card-hipodromo">
    <div class="card-header-custom">
        <h5><i class="fas fa-file-invoice-dollar me-2"></i>Facturas</h5>
        @if (esAdministrador)
        {
            <a href="@Url.Action("Crear")" class="btn-gold">
                <i class="fas fa-plus me-1"></i> Nueva Factura
            </a>
        }
    </div>
    <div class="card-body-custom p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5" style="color:var(--text-muted)">
                <i class="fas fa-file-invoice-dollar" style="font-size:3rem;opacity:.3"></i>
                <p class="mt-3">No hay facturas registradas aún.</p>
            </div>
        }
        else
        {
            <table class="table-hipodromo">
                <thead>
                    <tr>
                        <th>N° Factura</th>
                        <th>Propietario</th>
                        <th>Fecha</th>
                        <th>Subtotal</th>
                        <th>Descuento</th>
                        <th>IVA</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        var badgeClass = f.IdEstadoPago == 1 ? "badge-warn" : f.EstadoPago.ToLower().Contains("pagad") ? "badge-ok" : "badge-danger";
                        <tr>
                            <td style="color:var(--gold);font-weight:600">@f.NumeroFactura</td>
                            <td>@f.Propietario</td>
                            <td style="white-space:nowrap">@(f.FechaFactura?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>₡@f.Subtotal.ToString("N2")</td>
                            <td style="color:#4ade80">@(f.DescuentoPct > 0 ? $"-{f.DescuentoPct}%" : "—")</td>
                            <td>₡@f.ImpuestoIva.ToString("N2")</td>
                            <td style="font-weight:600;color:var(--gold)">₡@f.Total.ToString("N2")</td>
                            <td><span class="badge-salud @badgeClass">@f.EstadoPago</span></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("Detalle", new { id = f.IdFactura })" class="btn-outline-gold" style="font-size:.8rem;padding:4px 10px">
                                        <i class="fas fa-eye me-1"></i> Ver
                                    </a>
                                    @if (!f.EstadoPago.ToLower().Contains("pagad"))
                                    {
                                        <a href="@Url.Action("RegistrarPago", new { id = f.IdFactura })" class="btn-gold" style="font-size:.8rem;padding:4px 10px">
                                            <i class="fas fa-money-bill me-1"></i> Pagar
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
