@model Hipodromo_Nacional.ViewModels.RegistrarPagoViewModel
@{
    ViewData["Title"] = "Registrar Pago";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <div>
                    <h5 style="margin:0"><i class="fas fa-money-bill me-2"></i>Registrar Pago</h5>
                    <small style="color:var(--text-muted)">Factura @Model.NumeroFactura</small>
                </div>
                <a href="@Url.Action("Detalle", new { id = Model.IdFactura })" class="btn-outline-gold">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
            <div class="card-body-custom">

                <!-- Resumen saldo -->
                <div style="background:rgba(212,168,67,.08);border:1px solid rgba(212,168,67,.2);border-radius:8px;padding:16px;margin-bottom:24px">
                    <div class="d-flex justify-content-between mb-1" style="font-size:.85rem;color:var(--text-muted)">
                        <span>Total factura</span><span style="color:var(--text-primary)">₡@Model.TotalFactura.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between" style="font-weight:700">
                        <span style="color:var(--gold)">Saldo pendiente</span>
                        <span style="color:var(--gold)">₡@Model.SaldoPendiente.ToString("N2")</span>
                    </div>
                </div>

                <form asp-action="RegistrarPago" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdFactura" />
                    <input type="hidden" asp-for="NumeroFactura" />
                    <input type="hidden" asp-for="TotalFactura" />

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label-custom">Método de Pago *</label>
                            <select asp-for="IdMetodoPago" asp-items="Model.MetodosPago" class="form-select-custom">
                                <option value="">Seleccionar...</option>
                            </select>
                            <span asp-validation-for="IdMetodoPago" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Monto *</label>
                            <input asp-for="Monto" type="number" step="0.01" min="0.01" class="form-control-custom"
                                   placeholder="0.00" />
                            <span asp-validation-for="Monto" class="text-danger-custom"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label-custom">Referencia</label>
                            <input asp-for="Referencia" class="form-control-custom" placeholder="N° transferencia, cheque, etc." />
                        </div>
                        <div class="col-12">
                            <label class="form-label-custom">Observaciones</label>
                            <textarea asp-for="Observaciones" class="form-control-custom" rows="2"></textarea>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-3 pt-2">
                            <a href="@Url.Action("Detalle", new { id = Model.IdFactura })" class="btn-outline-gold py-2 px-4 text-decoration-none">Cancelar</a>
                            <button type="submit" class="btn-gold py-2 px-4">
                                <i class="fas fa-check me-2"></i> Confirmar Pago
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
