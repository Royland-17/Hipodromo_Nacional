@model Hipodromo_Nacional.ViewModels.EstabloViewModel
@{
    ViewData["Title"] = "Nuevo Establo";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-warehouse me-2"></i>Registrar Nuevo Establo</h5>
                <a href="@Url.Action("Index")" class="btn-outline-gold">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
            <div class="card-body-custom">
                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label class="form-label-custom">Nombre *</label>
                            <input asp-for="Nombre" class="form-control-custom" placeholder="Nombre del establo" />
                            <span asp-validation-for="Nombre" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label-custom">Ubicación *</label>
                            <input asp-for="Ubicacion" class="form-control-custom" placeholder="Sector A, Ala Norte..." />
                            <span asp-validation-for="Ubicacion" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Capacidad *</label>
                            <input asp-for="Capacidad" type="number" class="form-control-custom" placeholder="20" />
                            <span asp-validation-for="Capacidad" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Estado *</label>
                            <select asp-for="IdEstadoEstablo" asp-items="Model.EstadosEstablo" class="form-select-custom">
                                <option value="">Seleccionar...</option>
                            </select>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-3 pt-2">
                            <a href="@Url.Action("Index")" class="btn-outline-gold py-2 px-4 text-decoration-none">Cancelar</a>
                            <button type="submit" class="btn-gold py-2 px-4">
                                <i class="fas fa-save me-2"></i> Guardar Establo
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
