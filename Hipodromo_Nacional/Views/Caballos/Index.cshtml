@model List<Hipodromo_Nacional.ViewModels.CaballoListaViewModel>
@{
    ViewData["Title"] = "Gestión de Caballos";
}

<div class="card-hipodromo">
    <div class="card-header-custom">
        <h5><i class="fas fa-horse me-2"></i>Registro de Caballos</h5>
        <a href="@Url.Action("Crear")" class="btn-gold">
            <i class="fas fa-plus me-1"></i> Nuevo Caballo
        </a>
    </div>
    <div class="card-body-custom p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5" style="color:var(--text-muted)">
                <i class="fas fa-horse" style="font-size:3rem;opacity:.3"></i>
                <p class="mt-3">No hay caballos registrados aún.</p>
            </div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="table-hipodromo">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Edad</th>
                            <th>Peso (kg)</th>
                            <th>Sexo</th>
                            <th>Raza</th>
                            <th>Estado Salud</th>
                            <th>Propietario</th>
                            <th>Cert.</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td><span style="color:var(--gold);font-weight:600">@c.Codigo</span></td>
                                <td style="font-weight:500">@c.Nombre</td>
                                <td>@(c.EdadAnios.HasValue ? c.EdadAnios + " años" : "—")</td>
                                <td>@(c.PesoKg.HasValue ? c.PesoKg?.ToString("F1") : "—")</td>
                                <td>@(c.Sexo ?? "—")</td>
                                <td>@(c.Raza ?? "—")</td>
                                <td>
                                    @{
                                        var estadoClass = c.EstadoSalud?.ToLower() switch {
                                            var s when s?.Contains("sano") == true || s?.Contains("bueno") == true => "badge-ok",
                                            var s when s?.Contains("tratamiento") == true || s?.Contains("observac") == true => "badge-warn",
                                            var s when s?.Contains("critico") == true || s?.Contains("enfermo") == true => "badge-danger",
                                            _ => "badge-info"
                                        };
                                    }
                                    <span class="badge-salud @estadoClass">@(c.EstadoSalud ?? "—")</span>
                                </td>
                                <td>@(c.Propietario ?? "—")</td>
                                <td>
                                    @if (c.CertVigente == true)
                                    {
                                        <i class="fas fa-circle-check cert-vigente" title="Certificación vigente"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-circle-xmark cert-vencida" title="Sin certificación vigente"></i>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a href="@Url.Action("Editar", new { id = c.IdCaballo })" class="btn-outline-gold">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <button class="btn-outline-danger-custom"
                                                onclick="abrirModal(@c.IdCaballo, '@c.Nombre')">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Confirmar Desactivar -->
<div id="modalDesactivar" style="display:none;position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;background:rgba(0,0,0,.7);backdrop-filter:blur(4px)">
    <div style="background:var(--bg-card);border:1px solid rgba(239,68,68,.3);border-radius:16px;padding:36px;max-width:420px;width:90%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.5)">
        <div style="font-size:3rem;margin-bottom:16px">⚠️</div>
        <h5 style="font-family:'Playfair Display',serif;color:#f87171;font-size:1.2rem;margin-bottom:8px">Desactivar Caballo</h5>
        <p style="color:var(--text-muted);font-size:.9rem;margin-bottom:24px">
            ¿Estás segura de que deseas desactivar a <strong id="nombreCaballo" style="color:var(--text-primary)"></strong>? Esta acción lo ocultará del sistema.
        </p>
        <div class="d-flex gap-3 justify-content-center">
            <button onclick="cerrarModal()" style="background:transparent;border:1px solid var(--border);color:var(--text-muted);padding:10px 24px;border-radius:8px;cursor:pointer;font-size:.9rem;transition:all .2s" onmouseover="this.style.borderColor='var(--gold)';this.style.color='var(--gold)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">
                Cancelar
            </button>
            <form id="formDesactivar" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" style="background:linear-gradient(135deg,#ef4444,#b91c1c);border:none;color:white;padding:10px 24px;border-radius:8px;cursor:pointer;font-size:.9rem;font-weight:600">
                    <i class="fas fa-ban me-2"></i>Desactivar
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function abrirModal(id, nombre) {
        document.getElementById('nombreCaballo').textContent = nombre;
        document.getElementById('formDesactivar').action = '/Caballos/Desactivar/' + id;
        document.getElementById('modalDesactivar').style.display = 'flex';
    }
    function cerrarModal() {
        document.getElementById('modalDesactivar').style.display = 'none';
    }
    document.getElementById('modalDesactivar').addEventListener('click', function(e) {
        if (e.target === this) cerrarModal();
    });
</script>
}
