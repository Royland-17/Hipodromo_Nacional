@model Hipodromo_Nacional.ViewModels.CaballoViewModel
@{
    ViewData["Title"] = "Registrar Caballo";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-horse me-2"></i>Nuevo Registro de Caballo</h5>
                <a href="@Url.Action("Index")" class="btn-outline-gold">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
            <div class="card-body-custom">
                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label-custom">Código *</label>
                            <input asp-for="Codigo" class="form-control-custom" readonly />
                            <span asp-validation-for="Codigo" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label-custom">Nombre *</label>
                            <input asp-for="Nombre" class="form-control-custom" placeholder="Nombre del caballo" />
                            <span asp-validation-for="Nombre" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Fecha de Nacimiento *</label>
                            <input asp-for="FechaNacimiento" type="date" class="form-control-custom"
                                   min="1990-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   value="@DateTime.Today.AddYears(-3).ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="FechaNacimiento" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Peso (kg) *</label>
                            <input asp-for="PesoKg" type="number" step="0.1" class="form-control-custom" placeholder="450.0" />
                            <span asp-validation-for="PesoKg" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Sexo *</label>
                            <select asp-for="IdSexo" asp-items="Model.Sexos" class="form-select-custom">
                                <option value="">Seleccionar...</option>
                            </select>
                            <span asp-validation-for="IdSexo" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Raza *</label>
                            <select asp-for="IdRaza" asp-items="Model.Razas" class="form-select-custom">
                                <option value="">Seleccionar...</option>
                            </select>
                            <span asp-validation-for="IdRaza" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Estado de Salud *</label>
                            <select asp-for="IdEstadoSalud" asp-items="Model.EstadosSalud" class="form-select-custom">
                                <option value="">Seleccionar...</option>
                            </select>
                            <span asp-validation-for="IdEstadoSalud" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-12">
                            <div class="p-3" style="background:var(--bg-dark);border:1px solid var(--border);border-radius:8px;color:var(--text-muted)">
                                <i class="fas fa-user-lock me-2"></i>
                                El propietario se asigna automaticamente al usuario autenticado.
                            </div>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-3 pt-2">
                            <a href="@Url.Action("Index")" class="btn-outline-gold py-2 px-4 text-decoration-none">Cancelar</a>
                            <button type="submit" class="btn-gold py-2 px-4">
                                <i class="fas fa-save me-2"></i> Guardar Caballo
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
