<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Hipódromo Nacional</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <!-- Custom -->
    <link rel="stylesheet" href="~/css/hipodromo.css" />
</head>
<body>

<!-- SIDEBAR -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <span class="brand-icon">🐴</span>
        <div class="brand-text">
            <span class="brand-title">Hipódromo</span>
            <span class="brand-sub">Nacional</span>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-label">PRINCIPAL</div>
        <a href="@Url.Action("Index","Home")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
            <i class="fas fa-gauge-high"></i>
            <span>Dashboard</span>
        </a>

        <div class="nav-section-label mt-2">CABALLOS</div>
        <a href="@Url.Action("Index","Caballos")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Caballos" ? "active" : "")">
            <i class="fas fa-horse"></i>
            <span>Gestión de Caballos</span>
        </a>

        <div class="nav-section-label mt-2">VETERINARIA</div>
        <a href="@Url.Action("Index","HistorialVet")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "HistorialVet" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
            <i class="fas fa-stethoscope"></i>
            <span>Historial Veterinario</span>
        </a>
        <a href="@Url.Action("Certificaciones","HistorialVet")" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Certificaciones" ? "active" : "")">
            <i class="fas fa-certificate"></i>
            <span>Certificaciones</span>
        </a>

        <div class="nav-section-label mt-2">ESTABLOS</div>
        <a href="@Url.Action("Index","Establos")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Establos" ? "active" : "")">
            <i class="fas fa-warehouse"></i>
            <span>Gestión de Establos</span>
        </a>
        <a href="@Url.Action("Index","Asignaciones")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Asignaciones" ? "active" : "")">
            <i class="fas fa-link"></i>
            <span>Asignaciones</span>
        </a>
<div class="nav-section-label mt-2">CARRERAS</div>
<a href="@Url.Action("Index","Carreras")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Carreras" ? "active" : "")">
    <i class="fas fa-flag-checkered"></i>
    <span>Gestión de Carreras</span>
</a>
        <div class="nav-section-label mt-2">ALIMENTACION</div>
        <a href="@Url.Action("Index","Suministros")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Suministros" ? "active" : "")">
            <i class="fas fa-boxes-stacked"></i>
            <span>Suministros</span>
        </a>
        <a href="@Url.Action("Index","Alimentacion")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Alimentacion" ? "active" : "")">
            <i class="fas fa-bowl-food"></i>
            <span>Consumo por Caballo</span>
        </a>

        <div class="nav-section-label mt-2">FACTURACIÓN</div>
        <a href="@Url.Action("Index","Facturacion")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Facturacion" ? "active" : "")">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Facturas y Pagos</span>
        </a>

        <div class="nav-section-label mt-2">PERSONAS</div>
        <a href="@Url.Action("Index","Propietarios")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Propietarios" ? "active" : "")">
            <i class="fas fa-user-tie"></i>
            <span>Propietarios</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <i class="fas fa-trophy"></i> Sistema de Gestión Ecuestre
    </div>
</div>

<!-- CONTENIDO PRINCIPAL -->
<div class="main-content" id="mainContent">

    <!-- TOPBAR -->
    <header class="topbar">
        <button class="sidebar-toggle" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i>
        </button>
        <div class="topbar-title">@(ViewData["Title"] ?? "Dashboard")</div>
        <div class="topbar-right">
            <span class="topbar-badge"><i class="fas fa-circle-dot text-success me-1" style="font-size:.65rem"></i> Conectado a Supabase</span>
        </div>
    </header>

    <!-- ALERTAS TEMPDATA -->
    <div class="content-area">
        @if (TempData["Exito"] is string msg)
        {
            <div class="alert-custom alert-success-custom">
                <i class="fas fa-check-circle me-2"></i> @msg
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert-custom" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#f87171">
                <i class="fas fa-circle-exclamation me-2"></i> @err
            </div>
        }

        @RenderBody()
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('collapsed');
        document.getElementById('mainContent').classList.toggle('expanded');
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
