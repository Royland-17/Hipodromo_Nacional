<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Hipódromo Nacional</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <!-- Custom -->
    <link rel="stylesheet" href="~/css/hipodromo.css" />
</head>
<body>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var nombre = User.FindFirst("nombre_completo")?.Value ?? User.Identity?.Name ?? "Usuario";
    var esAdministrador = User.IsInRole("Administrador");
    var esPropietario = User.IsInRole("Propietario");
    var esVeterinario = User.IsInRole("Veterinario");
    var esEncargado = User.IsInRole("Encargado de Establo");
}

<div class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <span class="brand-icon">🐴</span>
        <div class="brand-text">
            <span class="brand-title">Hipódromo</span>
            <span class="brand-sub">Nacional</span>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-label">PRINCIPAL</div>
        <a href="@Url.Action("Index","Home")" class="nav-item @(controller == "Home" ? "active" : "")">
            <i class="fas fa-gauge-high"></i>
            <span>Dashboard</span>
        </a>

        @if (esPropietario)
        {
            <div class="nav-section-label mt-3">CABALLOS</div>
            <a href="@Url.Action("Index","Caballos")" class="nav-item @(controller == "Caballos" ? "active" : "")">
                <i class="fas fa-horse"></i>
                <span>Gestión de Caballos</span>
            </a>

            <div class="nav-section-label mt-3">PROPIETARIO</div>
            <a href="@Url.Action("Index","InscripcionesEventos")" class="nav-item @(controller == "InscripcionesEventos" ? "active" : "")">
                <i class="fas fa-flag-checkered"></i>
                <span>Inscribir en Eventos</span>
            </a>
            <a href="@Url.Action("Index","Resultados")" class="nav-item @(controller == "Resultados" ? "active" : "")">
                <i class="fas fa-list-check"></i>
                <span>Consultar Resultados</span>
            </a>
            <a href="@Url.Action("Index","Facturacion")" class="nav-item @(controller == "Facturacion" ? "active" : "")">
                <i class="fas fa-file-invoice-dollar"></i>
                <span>Datos de Facturación</span>
            </a>
        }

        @if (esVeterinario)
        {
            <div class="nav-section-label mt-3">VETERINARIA</div>
            <a href="@Url.Action("Index","HistorialVet")" class="nav-item @(controller == "HistorialVet" && action == "Index" ? "active" : "")">
                <i class="fas fa-stethoscope"></i>
                <span>Historial Veterinario</span>
            </a>
            <a href="@Url.Action("Certificaciones","HistorialVet")" class="nav-item @(controller == "HistorialVet" && action == "Certificaciones" ? "active" : "")">
                <i class="fas fa-certificate"></i>
                <span>Certificaciones</span>
            </a>
        }

        @if (esEncargado)
        {
            <div class="nav-section-label mt-3">ESPACIOS</div>
            <a href="@Url.Action("Index","Asignaciones")" class="nav-item @(controller == "Asignaciones" ? "active" : "")">
                <i class="fas fa-link"></i>
                <span>Asignaciones</span>
            </a>

            <div class="nav-section-label mt-3">ALIMENTACION</div>
            <a href="@Url.Action("Index","Suministros")" class="nav-item @(controller == "Suministros" ? "active" : "")">
                <i class="fas fa-boxes-stacked"></i>
                <span>Suministros</span>
            </a>
            <a href="@Url.Action("Index","Alimentacion")" class="nav-item @(controller == "Alimentacion" ? "active" : "")">
                <i class="fas fa-bowl-food"></i>
                <span>Consumo por Caballo</span>
            </a>
        }

        @if (esAdministrador)
        {
            <div class="nav-section-label mt-3">ADMINISTRACIÓN</div>
            <a href="@Url.Action("Index","Establos")" class="nav-item @(controller == "Establos" ? "active" : "")">
                <i class="fas fa-warehouse"></i>
                <span>Control de Establos</span>
            </a>
            <a href="@Url.Action("Index","Carreras")" class="nav-item @(controller == "Carreras" && action == "Index" ? "active" : "")">
                <i class="fas fa-flag-checkered"></i>
                <span>Gestión de Eventos</span>
            </a>
            <a href="@Url.Action("ControlInscripciones","Carreras")" class="nav-item @(controller == "Carreras" && (action == "ControlInscripciones" || action == "Inscripciones" || action == "RegistrarInscripcion") ? "active" : "")">
                <i class="fas fa-clipboard-check"></i>
                <span>Validación de Inscripciones</span>
            </a>
            <a href="@Url.Action("Index","Facturacion")" class="nav-item @(controller == "Facturacion" ? "active" : "")">
                <i class="fas fa-file-invoice-dollar"></i>
                <span>Facturación</span>
            </a>
        }
    </nav>

    <div style="padding:0 16px 12px 16px;">
        <a href="@Url.Action("MiUsuario","Cuenta")" class="btn-outline-gold d-block text-center text-decoration-none py-2 @(controller == "Cuenta" && action == "MiUsuario" ? "active" : "")">
            <i class="fas fa-id-badge me-1"></i> Mi Usuario
        </a>
    </div>

    <div class="sidebar-footer">
        <i class="fas fa-trophy"></i> Sistema de Gestión Ecuestre
    </div>
</div>

<div class="main-content" id="mainContent">
    <header class="topbar">
        <button class="sidebar-toggle" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i>
        </button>
        <div class="topbar-title">@(ViewData["Title"] ?? "Dashboard")</div>
        <div class="topbar-right d-flex align-items-center gap-3">
            <span class="topbar-badge"><i class="fas fa-circle-dot text-success me-1" style="font-size:.65rem"></i> Conectado a la base de datos </span>
            <span class="text-muted small">@nombre</span>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary">Cerrar sesión</button>
            </form>
        </div>
    </header>

    <div class="content-area">
        @if (TempData["Exito"] is string msg)
        {
            <div class="alert-custom alert-success-custom">
                <i class="fas fa-check-circle me-2"></i> @msg
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert-custom" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#f87171">
                <i class="fas fa-circle-exclamation me-2"></i> @err
            </div>
        }

        @RenderBody()
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('collapsed');
        document.getElementById('mainContent').classList.toggle('expanded');
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
