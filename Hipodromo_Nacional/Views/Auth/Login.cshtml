@model Hipodromo_Nacional.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Ingreso";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hipodromo Nacional</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="min-vh-100 d-flex align-items-center justify-content-center p-3" style="background: radial-gradient(circle at top, #f2e8d5 0%, #f8f9fa 45%, #eef2f6 100%);">
        <div class="card shadow-lg border-0" style="max-width: 440px; width: 100%; border-radius: 18px; overflow: hidden;">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center rounded-circle" style="width:64px;height:64px;background:#1f2937;color:#f5c451;">
                        <i class="fas fa-horse-head fa-lg"></i>
                    </div>
                    <h1 class="h4 mb-1">Hipodromo Nacional</h1>
                    <p class="text-muted mb-0">Ingreso al sistema por usuario</p>
                </div>

                <form asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UsuarioOIdentificacion" class="form-label"></label>
                        <input asp-for="UsuarioOIdentificacion" class="form-control form-control-lg" autocomplete="username" />
                        <span asp-validation-for="UsuarioOIdentificacion" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Contrasena" class="form-label"></label>
                        <input asp-for="Contrasena" class="form-control form-control-lg" autocomplete="current-password" />
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-dark btn-lg w-100">
                        <i class="fas fa-right-to-bracket me-2"></i>Ingresar
                    </button>
                </form>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
