@{
    ViewData["Title"] = "Dashboard";
}

@if (ViewBag.ConexionError == true)
{
    <div class="alert-custom" style="background:rgba(234,179,8,.1);border:1px solid rgba(234,179,8,.3);color:#facc15;margin-bottom:20px">
        <i class="fas fa-triangle-exclamation me-2"></i>
        No se pudo conectar a Supabase en este momento. Las estadísticas no están disponibles, pero puedes navegar por los módulos.
    </div>
}

<div class="dashboard-hero">
    <h1>Bienvenido al Hipódromo Nacional</h1>
    <p>Sistema de Gestión Ecuestre</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md col-6">
        <div class="stat-card">
            <div class="stat-icon">🐴</div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalCaballos</div>
                <div class="stat-label">Caballos Activos</div>
            </div>
        </div>
    </div>
    <div class="col-md col-6">
        <div class="stat-card">
            <div class="stat-icon">🏠</div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalEstablos</div>
                <div class="stat-label">Establos</div>
            </div>
        </div>
    </div>
    <div class="col-md col-6">
        <div class="stat-card">
            <div class="stat-icon">🔗</div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalAsignaciones</div>
                <div class="stat-label">Asignaciones Activas</div>
            </div>
        </div>
    </div>
    <div class="col-md col-6">
        <div class="stat-card">
            <div class="stat-icon">🩺</div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalHistorial</div>
                <div class="stat-label">Registros Veterinarios</div>
            </div>
        </div>
    </div>
    <div class="col-md col-6">
        <div class="stat-card">
            <div class="stat-icon">👤</div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalPropietarios</div>
                <div class="stat-label">Propietarios</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-horse me-2"></i>Accesos Rápidos</h5>
            </div>
            <div class="card-body-custom d-flex flex-column gap-3">
                <a href="@Url.Action("Crear","Caballos")" class="btn-gold text-center py-3 text-decoration-none d-block rounded-3">
                    <i class="fas fa-plus me-2"></i> Registrar Nuevo Caballo
                </a>
                <a href="@Url.Action("Crear","Asignaciones")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                    <i class="fas fa-link me-2"></i> Asignar Caballo a Establo
                </a>
                <a href="@Url.Action("Crear","HistorialVet")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                    <i class="fas fa-stethoscope me-2"></i> Registrar Revisión Veterinaria
                </a>
                <a href="@Url.Action("Crear","Propietarios")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                    <i class="fas fa-user-plus me-2"></i> Registrar Nuevo Propietario
                </a>
                <a href="@Url.Action("Crear","Facturacion")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                    <i class="fas fa-file-invoice-dollar me-2"></i> Nueva Factura
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-info-circle me-2"></i>Módulos del Sistema</h5>
            </div>
            <div class="card-body-custom">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex align-items-center gap-3 py-2" style="border-bottom:1px solid var(--border)">
                        <span style="font-size:1.4rem">🐴</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Gestión de Caballos</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Registro, edición y control de estado de salud</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-bottom:1px solid var(--border)">
                        <span style="font-size:1.4rem">🩺</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Historial Veterinario</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Revisiones, diagnósticos y certificaciones sanitarias</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-bottom:1px solid var(--border)">
                        <span style="font-size:1.4rem">🏠</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Control de Establos</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Administración de establos y capacidades</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2">
                        <span style="font-size:1.4rem">🔗</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Asignaciones</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Asignación de caballos a establos</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-top:1px solid var(--border)">
                        <span style="font-size:1.4rem">👤</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Propietarios</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Consulta, registro y mantenimiento de propietarios</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-top:1px solid var(--border)">
                        <span style="font-size:1.4rem">📊</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Reportes de Resultados</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Resultados de carreras y ranking de caballos</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-top:1px solid var(--border)">
                        <span style="font-size:1.4rem">🧾</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Facturación</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Facturas, pagos e historial de transacciones</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
