@{
    ViewData["Title"] = "Dashboard";
    var esAdministrador = User.IsInRole("Administrador");
    var esPropietario = User.IsInRole("Propietario");
    var esVeterinario = User.IsInRole("Veterinario");
    var esEncargado = User.IsInRole("Encargado de Establo");
}

<div class="dashboard-hero">
    <h1>Bienvenido al Hipódromo Nacional</h1>
    <p>Sistema de Gestión Ecuestre</p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-horse me-2"></i>Accesos Rápidos</h5>
            </div>
            <div class="card-body-custom d-flex flex-column gap-3">
                @if (esPropietario)
                {
                    <a href="@Url.Action("Crear","Caballos")" class="btn-gold text-center py-3 text-decoration-none d-block rounded-3">
                        <i class="fas fa-plus me-2"></i> Registrar Nuevo Caballo
                    </a>
                    <a href="@Url.Action("Index","InscripcionesEventos")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                        <i class="fas fa-flag-checkered me-2"></i> Inscribir Animales en Eventos
                    </a>
                    <a href="@Url.Action("Index","Resultados")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                        <i class="fas fa-list-check me-2"></i> Consultar Resultados
                    </a>
                    <a href="@Url.Action("Index","Facturacion")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                        <i class="fas fa-file-invoice-dollar me-2"></i> Datos de Facturación
                    </a>
                }
                @if (esEncargado)
                {
                    <a href="@Url.Action("Crear","Asignaciones")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                        <i class="fas fa-link me-2"></i> Asignar Caballo a Establo
                    </a>
                }
                @if (esVeterinario)
                {
                    <a href="@Url.Action("Crear","HistorialVet")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                        <i class="fas fa-stethoscope me-2"></i> Registrar Revisión Veterinaria
                    </a>
                }
                @if (esAdministrador)
                {
                    <a href="@Url.Action("Index","Establos")" class="btn-gold text-center py-3 text-decoration-none d-block rounded-3">
                        <i class="fas fa-warehouse me-2"></i> Control de Establos
                    </a>
                    <a href="@Url.Action("Index","Carreras")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                        <i class="fas fa-flag-checkered me-2"></i> Gestión de Eventos
                    </a>
                    <a href="@Url.Action("Index","Carreras")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                        <i class="fas fa-clipboard-check me-2"></i> Validación de Inscripciones
                    </a>
                    <a href="@Url.Action("Index","Facturacion")" class="btn-outline-gold text-center py-3 text-decoration-none d-block rounded-3">
                        <i class="fas fa-file-invoice-dollar me-2"></i> Supervisión de Facturación
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-info-circle me-2"></i>Módulos del Sistema</h5>
            </div>
            <div class="card-body-custom">
                <div class="d-flex flex-column gap-2">
                    @if (esPropietario)
                    {
                    <div class="d-flex align-items-center gap-3 py-2" style="border-bottom:1px solid var(--border)">
                        <span style="font-size:1.4rem">🐴</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Gestión de Caballos</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Registro, edición y consulta de caballos</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-bottom:1px solid var(--border)">
                        <span style="font-size:1.4rem">🏁</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Inscripciones a Eventos</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Registro de participación de caballos en eventos</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-bottom:1px solid var(--border)">
                        <span style="font-size:1.4rem">📊</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Consulta de Resultados</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Revisión de resultados de participación en eventos</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-bottom:1px solid var(--border)">
                        <span style="font-size:1.4rem">💵</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Datos de Facturación</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Consulta de estados y movimientos de facturación</div>
                        </div>
                    </div>
                    }
                    @if (esVeterinario)
                    {
                    <div class="d-flex align-items-center gap-3 py-2" style="border-bottom:1px solid var(--border)">
                        <span style="font-size:1.4rem">🩺</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Historial Veterinario</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Revisiones, diagnósticos y certificaciones sanitarias</div>
                        </div>
                    </div>
                    }
                    @if (esEncargado)
                    {
                    <div class="d-flex align-items-center gap-3 py-2" style="border-bottom:1px solid var(--border)">
                        <span style="font-size:1.4rem">🔗</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Asignación de Espacios</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Asignación y seguimiento de espacios por caballo</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2">
                        <span style="font-size:1.4rem">🍽️</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Alimentación y Suministros</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Control de consumo y abastecimiento operativo</div>
                        </div>
                    </div>
                    }
                    @if (esAdministrador)
                    {
                    <div class="d-flex align-items-center gap-3 py-2" style="border-top:1px solid var(--border)">
                        <span style="font-size:1.4rem">🏠</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Control de Establos</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Administración y control de capacidad/estado de establos</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-top:1px solid var(--border)">
                        <span style="font-size:1.4rem">🏁</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Gestión de Eventos</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Administración de eventos hípicos y su programación</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-top:1px solid var(--border)">
                        <span style="font-size:1.4rem">📝</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Validación de Inscripciones</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Revisión y aprobación de inscripciones a eventos</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 py-2" style="border-top:1px solid var(--border)">
                        <span style="font-size:1.4rem">💵</span>
                        <div>
                            <div style="font-weight:600;font-size:.9rem">Supervisión de Facturación</div>
                            <div style="color:var(--text-muted);font-size:.78rem">Seguimiento de cobros, estados y reportes contables</div>
                        </div>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
