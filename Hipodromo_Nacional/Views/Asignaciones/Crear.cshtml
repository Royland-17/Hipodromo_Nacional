@model Hipodromo_Nacional.ViewModels.AsignacionViewModel
@{
    ViewData["Title"] = "Asignar Caballo a Establo";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-link me-2"></i>Nueva Asignación</h5>
                <a href="@Url.Action("Index")" class="btn-outline-gold">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
            <div class="card-body-custom">
                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label-custom">Caballo *</label>
                            <select asp-for="IdCaballo" asp-items="Model.Caballos" class="form-select-custom">
                                <option value="">Seleccionar caballo...</option>
                            </select>
                            <span asp-validation-for="IdCaballo" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Establo *</label>
                            <select asp-for="IdEstablo" asp-items="Model.Establos" class="form-select-custom">
                                <option value="">Seleccionar establo...</option>
                            </select>
                            <span asp-validation-for="IdEstablo" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Fecha de Ingreso *</label>
                            <input asp-for="FechaIngreso" type="date" class="form-control-custom" />
                            <span asp-validation-for="FechaIngreso" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label-custom">Observaciones</label>
                            <textarea asp-for="Observaciones" class="form-control-custom" rows="3"
                                      placeholder="Notas adicionales sobre la asignación..."></textarea>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-3 pt-2">
                            <a href="@Url.Action("Index")" class="btn-outline-gold py-2 px-4 text-decoration-none">Cancelar</a>
                            <button type="submit" class="btn-gold py-2 px-4">
                                <i class="fas fa-save me-2"></i> Confirmar Asignación
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
