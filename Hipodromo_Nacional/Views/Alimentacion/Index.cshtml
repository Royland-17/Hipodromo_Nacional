@model AlimentacionIndexViewModel
@{
    ViewData["Title"] = "Alimentacion";
}

<div class="card-hipodromo mb-4">
    <div class="card-header-custom">
        <h5><i class="fas fa-wheat-awn me-2"></i>Consumo por Caballo</h5>
        <a asp-action="Crear" class="btn-gold text-decoration-none">
            <i class="fas fa-plus me-1"></i> Registrar consumo
        </a>
    </div>
    <div class="card-body-custom">
        <form asp-action="Index" method="get">
        <div class="row g-4 align-items-end">
            <div class="col-md-3">
                <label asp-for="Filtro.IdCaballo" class="form-label-custom"></label>
                <select asp-for="Filtro.IdCaballo" asp-items="Model.Filtro.Caballos" class="form-select-custom">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Filtro.IdTipoSuministro" class="form-label-custom"></label>
                <select asp-for="Filtro.IdTipoSuministro" asp-items="Model.Filtro.TiposAlimento" class="form-select-custom">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Filtro.FechaDesde" class="form-label-custom"></label>
                <input asp-for="Filtro.FechaDesde" type="date" class="form-control-custom" />
            </div>
            <div class="col-md-2">
                <label asp-for="Filtro.FechaHasta" class="form-label-custom"></label>
                <input asp-for="Filtro.FechaHasta" type="date" class="form-control-custom" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn-gold w-100">Filtrar</button>
                <a asp-action="Index" class="btn-outline-gold text-decoration-none">Limpiar</a>
            </div>
        </div>
        </form>
    </div>
</div>

<div class="card-hipodromo">
    <div class="card-body-custom" style="padding:0;">
        <div style="overflow-x:auto">
            <table class="table-hipodromo">
                <thead>
                    <tr>
                        <th>Caballo</th>
                        <th>Tipo de alimento</th>
                        <th>Alimento</th>
                        <th>Fecha</th>
                        <th class="text-end">Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Registros.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-state-custom">No hay consumos registrados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Registros)
                    {
                        <tr>
                            <td>@item.Caballo</td>
                            <td>@item.TipoAlimento</td>
                            <td>@item.Alimento</td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">@item.Cantidad</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
