@model List<Hipodromo_Nacional.ViewModels.HistorialVetResultado>
@{
    ViewData["Title"] = "Historial Veterinario";
}

<div class="card-hipodromo">
    <div class="card-header-custom">
        <h5><i class="fas fa-stethoscope me-2"></i>Historial de Revisiones Veterinarias</h5>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Certificaciones")" class="btn-outline-gold">
                <i class="fas fa-certificate me-1"></i> Certificaciones
            </a>
            <a href="@Url.Action("Crear")" class="btn-gold">
                <i class="fas fa-plus me-1"></i> Nueva Revisión
            </a>
        </div>
    </div>
    <div class="card-body-custom p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5" style="color:var(--text-muted)">
                <i class="fas fa-stethoscope" style="font-size:3rem;opacity:.3"></i>
                <p class="mt-3">No hay registros veterinarios aún.</p>
            </div>
        }
        else
        {
            <table class="table-hipodromo">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Caballo</th>
                        <th>Veterinario</th>
                        <th>Diagnóstico</th>
                        <th>Tratamiento</th>
                        <th>Próximo Control</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td style="white-space:nowrap;color:var(--gold)">
                                @h.FechaRevision.ToString("dd/MM/yyyy")
                            </td>
                            <td style="font-weight:500">@h.NombreCaballo</td>
                            <td style="color:var(--text-muted)">@h.NombreVeterinario</td>
                            <td>@h.Diagnostico</td>
                            <td style="color:var(--text-muted);font-size:.83rem">@(h.Tratamiento ?? "—")</td>
                            <td>
                                @if (h.ProximoControl.HasValue)
                                {
                                    var vence = h.ProximoControl.Value < DateOnly.FromDateTime(DateTime.Today);
                                    <span class="badge-salud @(vence ? "badge-danger" : "badge-info")">
                                        @h.ProximoControl.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted)">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
