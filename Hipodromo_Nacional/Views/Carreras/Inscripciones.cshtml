@model Hipodromo_Nacional.ViewModels.InscripcionesCarreraViewModel
@{
    ViewData["Title"] = "Inscripciones de Carrera";
}

<div class="card-hipodromo">
    <div class="card-header-custom">
        <h5><i class="fas fa-list-check me-2"></i>Inscripciones — @Model.Carrera.Nombre</h5>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index")" class="btn-outline-gold">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>
            <a href="@Url.Action("RegistrarInscripcion", new { id = Model.Carrera.IdEvento })" class="btn-gold">
                <i class="fas fa-plus me-1"></i> Inscribir Caballo
            </a>
        </div>
    </div>
    <div class="card-body-custom p-0">
        <div style="padding:18px 24px;border-bottom:1px solid var(--border);color:var(--text-muted);font-size:.86rem">
            <span style="color:var(--gold);font-weight:600">@Model.Carrera.CodigoEvento</span>
            <span class="mx-2">•</span>
            @Model.Carrera.FechaEvento.ToString("dd/MM/yyyy HH:mm")
            <span class="mx-2">•</span>
            @Model.Carrera.Estado
        </div>

        @if (!Model.Inscripciones.Any())
        {
            <div class="text-center py-5" style="color:var(--text-muted)">
                <i class="fas fa-list-check" style="font-size:3rem;opacity:.3"></i>
                <p class="mt-3">No hay caballos inscritos en esta carrera.</p>
            </div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="table-hipodromo">
                    <thead>
                        <tr>
                            <th>Salida</th>
                            <th>Caballo</th>
                            <th>Fecha inscripción</th>
                            <th>Estado</th>
                            <th>Observaciones</th>
                            <th>Resultado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model.Inscripciones)
                        {
                            <tr>
                                <td>@(i.PosicionSalida?.ToString() ?? "—")</td>
                                <td>
                                    <span style="font-weight:500">@i.Caballo</span>
                                    <span style="color:var(--gold);font-size:.78rem;margin-left:6px">@i.CodigoCaballo</span>
                                </td>
                                <td>@(i.FechaInscripcion?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td><span class="badge-salud badge-info">@i.Estado</span></td>
                                <td>@(i.Observaciones ?? "—")</td>
                                <td>
                                    <a href="@Url.Action("RegistrarResultado", new { id = i.IdInscripcion })" class="@(i.TieneResultado ? "btn-outline-gold" : "btn-gold")">
                                        <i class="fas fa-trophy me-1"></i> @(i.TieneResultado ? "Editar" : "Registrar")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
