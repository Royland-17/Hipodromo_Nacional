@model Hipodromo_Nacional.ViewModels.InscripcionCarreraViewModel
@{
    ViewData["Title"] = "Inscribir Caballo";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-list-check me-2"></i>Inscribir Caballo — @Model.Carrera.Nombre</h5>
                <a href="@Url.Action("Inscripciones", new { id = Model.IdEvento })" class="btn-outline-gold">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
            <div class="card-body-custom">
                <form asp-action="RegistrarInscripcion" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="IdEvento" type="hidden" />
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label-custom">Caballo *</label>
                            <select asp-for="IdCaballo" asp-items="Model.Caballos" class="form-select-custom">
                                <option value="">Seleccionar...</option>
                            </select>
                            <span asp-validation-for="IdCaballo" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">Posición salida</label>
                            <input asp-for="PosicionSalida" type="number" class="form-control-custom" />
                            <span asp-validation-for="PosicionSalida" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">Estado *</label>
                            <select asp-for="IdEstadoInscripcion" asp-items="Model.EstadosInscripcion" class="form-select-custom">
                                <option value="">Seleccionar...</option>
                            </select>
                            <span asp-validation-for="IdEstadoInscripcion" class="text-danger-custom"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label-custom">Observaciones</label>
                            <textarea asp-for="Observaciones" class="form-control-custom" rows="3"></textarea>
                            <span asp-validation-for="Observaciones" class="text-danger-custom"></span>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-3 pt-2">
                            <a href="@Url.Action("Inscripciones", new { id = Model.IdEvento })" class="btn-outline-gold py-2 px-4 text-decoration-none">Cancelar</a>
                            <button type="submit" class="btn-gold py-2 px-4">
                                <i class="fas fa-save me-2"></i> Guardar Inscripción
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
