@model Hipodromo_Nacional.ViewModels.ResultadoCarreraViewModel
@{
    ViewData["Title"] = "Registrar Resultado";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-hipodromo">
            <div class="card-header-custom">
                <h5><i class="fas fa-trophy me-2"></i>Resultado — @Model.Caballo</h5>
                <a href="@Url.Action("Resultados", new { id = Model.IdEvento })" class="btn-outline-gold">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
            <div class="card-body-custom">
                <div style="color:var(--text-muted);font-size:.86rem;margin-bottom:22px">
                    <span style="color:var(--gold);font-weight:600">@Model.Carrera.CodigoEvento</span>
                    <span class="mx-2">•</span>
                    @Model.Carrera.Nombre
                    <span class="mx-2">•</span>
                    @Model.CodigoCaballo
                </div>

                <form asp-action="RegistrarResultado" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="IdResultado" type="hidden" />
                    <input asp-for="IdEvento" type="hidden" />
                    <input asp-for="IdInscripcion" type="hidden" />

                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label-custom">Posición final *</label>
                            <input asp-for="PosicionFinal" type="number" class="form-control-custom" />
                            <span asp-validation-for="PosicionFinal" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Tiempo (segundos)</label>
                            <input asp-for="TiempoSegundos" type="number" step="0.001" class="form-control-custom" />
                            <span asp-validation-for="TiempoSegundos" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Premio obtenido</label>
                            <input asp-for="PremioObtenido" type="number" step="0.01" class="form-control-custom" />
                            <span asp-validation-for="PremioObtenido" class="text-danger-custom"></span>
                        </div>
                        <div class="col-md-4 d-flex align-items-center pt-3">
                            <label style="display:flex;align-items:center;gap:10px;color:var(--text-primary)">
                                <input asp-for="Descalificado" type="checkbox" />
                                Descalificado
                            </label>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label-custom">Motivo de descalificación</label>
                            <textarea asp-for="MotivoDescalificacion" class="form-control-custom" rows="3"></textarea>
                            <span asp-validation-for="MotivoDescalificacion" class="text-danger-custom"></span>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-3 pt-2">
                            <a href="@Url.Action("Resultados", new { id = Model.IdEvento })" class="btn-outline-gold py-2 px-4 text-decoration-none">Cancelar</a>
                            <button type="submit" class="btn-gold py-2 px-4">
                                <i class="fas fa-save me-2"></i> Guardar Resultado
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
