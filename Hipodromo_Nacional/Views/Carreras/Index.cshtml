@model List<Hipodromo_Nacional.ViewModels.CarreraListaViewModel>
@{
    ViewData["Title"] = "Gestión de Carreras";
}

<div class="card-hipodromo">
    <div class="card-header-custom">
        <h5><i class="fas fa-flag-checkered me-2"></i>Registro de Carreras</h5>
        <a href="@Url.Action("Crear")" class="btn-gold">
            <i class="fas fa-plus me-1"></i> Nueva Carrera
        </a>
    </div>
    <div class="card-body-custom p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5" style="color:var(--text-muted)">
                <i class="fas fa-flag-checkered" style="font-size:3rem;opacity:.3"></i>
                <p class="mt-3">No hay carreras registradas aún.</p>
            </div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="table-hipodromo">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Carrera</th>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Distancia</th>
                            <th>Premio</th>
                            <th>Inscripción</th>
                            <th>Inscritos</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            var estado = c.Estado?.ToLower() ?? "";
                            var estadoClass = estado.Contains("cancel") || estado.Contains("suspend")
                                ? "badge-danger"
                                : estado.Contains("final") || estado.Contains("cerr")
                                    ? "badge-info"
                                    : estado.Contains("program") || estado.Contains("abiert")
                                        ? "badge-ok"
                                        : "badge-warn";

                            <tr>
                                <td><span style="color:var(--gold);font-weight:600">@c.CodigoEvento</span></td>
                                <td style="font-weight:500">@c.Nombre</td>
                                <td>@c.FechaEvento.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@c.TipoCarrera</td>
                                <td>@c.DistanciaMetros m</td>
                                <td>@c.PremioTotal.ToString("C")</td>
                                <td>@c.PrecioInscripcion.ToString("C")</td>
                                <td>@c.TotalInscritos</td>
                                <td><span class="badge-salud @estadoClass">@c.Estado</span></td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a href="@Url.Action("Editar", new { id = c.IdEvento })" class="btn-outline-gold" title="Editar">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a href="@Url.Action("Inscripciones", new { id = c.IdEvento })" class="btn-outline-gold" title="Inscripciones">
                                            <i class="fas fa-list-check"></i>
                                        </a>
                                        <a href="@Url.Action("Resultados", new { id = c.IdEvento })" class="btn-gold" title="Resultados">
                                            <i class="fas fa-trophy"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
